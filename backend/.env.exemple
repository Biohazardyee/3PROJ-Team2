DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/melodia
PORT=3000
JWT_SECRET=your_jwt_secret

# API musicale (Last.fm) — requis
API_ROOT_URL=https://ws.audioscrobbler.com/2.0/
