// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique @db.VarChar(25)
  email             String   @unique @db.VarChar(320)
  password          String
  favorite_band     String
  profile_picture   Bytes
  role              Role     @default(BASIC)
  has_notifications Boolean  @default(true)
  phone_number      String?  @db.VarChar(15)
  biography         String?  @db.VarChar(255)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  reviews              Review[]
  review_comments      ReviewComment[]
  review_likes         ReviewLike[]
  playlists            Playlist[]
  follows              Follow[]          @relation("following")
  followers            Follow[]          @relation("followers")
  notifications        Notification[]    @relation("user_notifications")
  notificationsRelated Notification[]    @relation("user_related_notifications")
  user_media_status    UserMediaStatus[]
  reports              Report[]
  bannedUsers          BannedUsers?

  activities          Activity[]     @relation("user_activities")
  activities_targets  Activity[]     @relation("user_activities_targets")
  conversations_user1 Conversation[] @relation("conversation_user1")
  conversations_user2 Conversation[] @relation("conversation_user2")
  messages            Message[]
}

enum Role {
  BASIC
  ADMIN
}

model Media {
  id         String   @id @default(uuid())
  api_id     String
  created_at DateTime @default(now())

  reviews           Review[]
  playlist_items    PlaylistItem[]
  user_music_status UserMediaStatus[]
  notifications     Notification[]
  activities        Activity[]
}

model Review {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  media      Media    @relation(fields: [media_id], references: [id])
  media_id   String
  rating     Float
  content    String   @db.VarChar(1000)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  comments ReviewComment[]
  likes    ReviewLike[]
  reports  Report[]

  notifications Notification[]

  activities Activity[]

  @@unique([user_id, media_id])
}

model ReviewComment {
  id         String   @id @default(uuid())
  review     Review   @relation(fields: [review_id], references: [id])
  review_id  String
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  content    String   @db.VarChar(1000)
  created_at DateTime @default(now())
  reports    Report[]
}

model ReviewLike {
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  review     Review   @relation(fields: [review_id], references: [id])
  review_id  String
  created_at DateTime @default(now())

  @@id([user_id, review_id])
}

model Playlist {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  name       String   @db.VarChar(30)
  is_public  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items PlaylistItem[]

  @@unique([user_id, name])
}

model PlaylistItem {
  id          String   @id @default(uuid())
  playlist    Playlist @relation(fields: [playlist_id], references: [id])
  playlist_id String
  media       Media    @relation(fields: [media_id], references: [id])
  media_id    String

  @@unique([playlist_id, media_id])
}

model UserMediaStatus {
  user       User        @relation(fields: [user_id], references: [id])
  user_id    String
  media      Media       @relation(fields: [media_id], references: [id])
  media_id   String
  status     MediaStatus
  created_at DateTime    @default(now())

  @@id([user_id, media_id])
}

enum MediaStatus {
  planned
  listening
  completed
  abandoned
}

model Activity {
  id               String         @id @default(uuid())
  user             User           @relation("user_activities", fields: [user_id], references: [id])
  user_id          String
  target_user      User?          @relation("user_activities_targets", fields: [target_user_id], references: [id])
  target_user_id   String?
  review           Review?        @relation(fields: [review_id], references: [id])
  review_id        String?
  media            Media?         @relation(fields: [media_id], references: [id])
  media_id         String?
  rating_from_user Int?
  action           ActivityAction
  created_at       DateTime       @default(now())
}

enum ActivityAction {
  review_created
  rating_added
  playlist_added
  follow
}

model Follow {
  user           User     @relation("following", fields: [user_id], references: [id])
  user_id        String
  follow_user    User     @relation("followers", fields: [follow_user_id], references: [id])
  follow_user_id String
  created_at     DateTime @default(now())

  @@id([user_id, follow_user_id])
}

model Report {
  id          String     @id @default(uuid())
  reporter    User       @relation(fields: [reporter_id], references: [id])
  reporter_id String
  review      Review?    @relation(fields: [review_id], references: [id])
  review_id   String?
  reason      String
  reason_type ReportType
  is_checked  Boolean    @default(false)
  created_at  DateTime   @default(now())

  reviewComments ReviewComment[]
}

enum ReportType {
  comment
  profile
  review
}

model Notification {
  id              String             @id @default(uuid())
  user            User               @relation("user_notifications", fields: [user_id], references: [id])
  user_id         String
  action          NotificationAction
  related_user    User?              @relation("user_related_notifications", fields: [related_user_id], references: [id])
  related_user_id String?
  review          Review?            @relation(fields: [review_id], references: [id])
  review_id       String?
  media           Media?             @relation(fields: [media_id], references: [id])
  media_id        String?
  is_read         Boolean            @default(false)
  read_at         DateTime?
  created_at      DateTime           @default(now())
}

model BannedUsers {
  id      String @id @default(uuid())
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @unique
  content String @db.VarChar(255)
}

enum NotificationAction {
  like_added
  comment_added
  new_follow
  recommendation
}

model Conversation {
  id         String    @id @default(uuid())
  user1      User      @relation("conversation_user1", fields: [user1_id], references: [id])
  user1_id   String
  user2      User      @relation("conversation_user2", fields: [user2_id], references: [id])
  user2_id   String
  created_at DateTime  @default(now())
  messages   Message[]

  @@unique([user1_id, user2_id])
}

model Message {
  id              String       @id @default(uuid())
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  conversation_id String
  sender          User         @relation(fields: [sender_id], references: [id])
  sender_id       String
  content         String       @db.VarChar(1000)
  is_read         Boolean      @default(false)
  created_at      DateTime     @default(now())
}
